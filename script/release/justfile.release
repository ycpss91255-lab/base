# base self-release tooling (`just release <recipe>`). The release itself
# runs in self-test.yaml's `release` job and release-worker.yaml.

# Recipes run from the repo root, as a module or by `just -f`.
set working-directory := '../..'

# Arguments reach a recipe body as "$@"; {{args}} would be re-split.
set positional-arguments := true

# source_file, not justfile: in a module, justfile is the root entry.
# Default: list available recipes
default:
    @just --justfile '{{source_file()}}' --list

# just release coverage-badge -> regenerate doc/badge/coverage.svg from the
# kcov reports under coverage/. A HAND-RUN STEP (docker_harness#289):
#
#   1. `just test coverage` -- the FULL run, on the UNMODIFIED tree
#   2. bump `.version` (and promote the CHANGELOG section)
#   3. `just release coverage-badge`
#   4. the `chore: release vX.Y.Z` commit
#
# Bumping first fails "the committed badge names the released version".
#
# `--unmeasured` renders "not measured" for a version with no measurement;
# the bump must never pass it.
coverage-badge *args:
    ./script/release/coverage_badge.sh "$@"

# just release changelog-index -> re-render the generated series index in
# doc/changelog/CHANGELOG.md. Print-only, as the layout lint
# runs:  ./script/release/changelog_index.sh doc/changelog
changelog-index *args:
    ./script/release/changelog_index.sh --write "$@"
